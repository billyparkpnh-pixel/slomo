# Node 24 loads this file automatically. Never commit real credentials.
HOST=0.0.0.0
PORT=3000
DATA_DIR=./data
SITE_URL=http://localhost:3000
# Set a unique password of 12 or more characters before production.
# ADMIN_PASSWORD=
# NODE_ENV=production
# Production requires HTTPS SITE_URL, ADMIN_PASSWORD and DEMO_MODE=false.
DEMO_MODE=true
# Set only when the app port is private behind exactly this many trusted proxies.
TRUST_PROXY_HOPS=0
# Leave unset for the local email outbox. Set both to enable real emails.
# RESEND_API_KEY=
# MAIL_FROM=SLOMO <bookings@your-verified-domain.com>
# ADMIN_EMAIL=bookings@your-domain.com
